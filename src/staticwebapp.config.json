{
  "routes": [
    { "route": "/fwsc/*", "headers": { "Access-Control-Allow-Origin": "*" } },
    { "route": "/wasm-clang/*", "headers": { "Access-Control-Allow-Origin": "*" } }
  ],
  "mimeTypes": {
    ".tar": "application/x-tar"
  },
  "responseOverrides": {
    "404": { "rewrite": "/error.html" }
  }
}
