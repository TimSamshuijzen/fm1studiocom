# The firmware build runs in Linux (WSL): its scripts keep Unix line ends on every computer.
firmware/**/*.sh text eol=lf
firmware/*.sh text eol=lf
firmware/*.py text eol=lf
firmware/**/*.py text eol=lf
# The files of the compiler are made by firmware/web: Git must not change a byte of them.
src/fwsc/llvm.js -text
src/fwsc/platform.json -text
firmware/*.cmd text eol=crlf
# The files of the INSTALL button are copies from fm1-base: Git must not change a byte of them.
src/install/*.js -text
src/install/LICENSE -text
